# Конфиг b24-mcp. СЕКРЕТОВ В ЭТОМ ФАЙЛЕ НЕТ — это шаблон.
#
#   cp .env.example .env && chmod 600 .env
#
# Реальный .env в .gitignore и в репозиторий не попадёт.

# Полный URL входящего вебхука, со слешем на конце.
# <портал> — хост как есть: облачный (компания.bitrix24.ru и т.п.)
# или коробочный на своём домене либо IP.
B24_WEBHOOK=https://<портал>/rest/<число>/<токен>/

# Необязательно: id владельца вебхука. Без него определится через user.current.
B24_USER_ID=
